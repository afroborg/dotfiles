# vim: set ft=zsh :

[[ -x "$(command -v eza)" ]] && alias ls='eza -algHS'
[[ -x "$(command -v bat)" ]] && alias cat='bat'
alias grep='grep --color'
alias mkdir='mkdir -p'
alias vim='nvim'
alias vi='nvim'
alias ..='cd ..'
alias ...='cd ../..'
alias cdgr='cd "$(git rev-parse --show-toplevel)"'
[[ -x "$(command -v lazygit)" ]] && alias lg='lazygit'
[[ -x "$(command -v lazydocker)" ]] && alias ld='lazydocker'
[[ -x "$(command -v zoxide)" ]] && alias cd='z'


alias src='source ~/.zshrc'

[[ -f ~/.alias.local ]] && source ~/.alias.local
