# vim: set ft=zsh :

function ipexternal() {
    if [[ -x "$(command -v curl)" ]]; then
        curl -s icanhazip.com && echo
    else
        echo "Curl required"
    fi
}


function largest-files() {
    local c=$1
    if [[ -z $c ]]; then
        c=10
    fi

    du -hs * | sort -hr | head -n $c
}

function flush-dns() {
  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder
}
