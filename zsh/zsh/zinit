# vim: set ft=zsh :

source $HOMEBREW_PREFIX/opt/zinit/zinit.zsh

# Two-column table: each plugin and its load mode.
#   wait = deferred (Turbo mode, loads just after the prompt) — the default choice
#   now  = eager (loaded during startup, active from the very first keystroke)
zinit_plugins=(
    casonadams/skim.zsh             wait
    zsh-users/zsh-completions       wait
    zsh-users/zsh-autosuggestions   wait
    jeffreytse/zsh-vi-mode          now
)

omzp_plugins=(
    git
    command-not-found
    brew
    #    starship disabled due to this issue: https://github.com/starship/starship/issues/3418
    docker
    mise
    zoxide
)

for plugin mode in $zinit_plugins; do
    [[ "$mode" == wait ]] && zinit ice wait lucid
    zinit light "$plugin"
done
unset plugin mode

for p in $omzp_plugins; do
    zinit ice wait lucid
    zinit snippet OMZP::$p
done

# syntax-highlighting must load last so it can wrap the widgets defined above;
# its atinit runs compinit and replays the completions captured during turbo load.
zinit ice wait lucid atinit'zicompinit; zicdreplay'
zinit light zsh-users/zsh-syntax-highlighting
